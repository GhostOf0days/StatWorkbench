{
  "name": "statworkbench-desktop",
  "version": "0.1.0",
  "description": "Open-source desktop spreadsheet and statistical analysis application",
  "main": "electron/main.cjs",
  "author": "StatWorkbench contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "test:desktop": "npm run build:renderer && node scripts/verify_desktop.cjs",
    "test:renderer": "node scripts/test_renderer.cjs",
    "test:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer/app.js && node --check renderer/charts.js",
    "test:signing": "node --test scripts/test_release_signing.cjs",
    "pack": "npm run build:renderer && electron-builder --config electron-builder.config.cjs --dir",
    "dist": "npm run build:renderer && electron-builder --config electron-builder.config.cjs",
    "build:icons": "node scripts/build_icons.cjs",
    "build:excel-addin": "powershell.exe -NoLogo -NoProfile -NonInteractive -File addin/windows/Build.ps1",
    "test:excel-ribbon": "python scripts/generate_excel_ribbon.py --check",
    "build:windows-bridge": "python scripts/build_windows_bridge.py"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@univerjs/engine-formula": "1.0.4",
    "@univerjs/preset-sheets-core": "1.0.4",
    "@univerjs/preset-sheets-drawing": "1.0.4",
    "@univerjs/preset-sheets-sort": "1.0.4",
    "@univerjs/presets": "1.0.4"
  },
  "type": "module"
}
