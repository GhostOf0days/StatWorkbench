{
  "name": "statworkbench-desktop",
  "version": "0.1.0",
  "description": "Open-source desktop spreadsheet and statistical analysis application",
  "main": "electron/main.cjs",
  "author": "StatWorkbench contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "test:desktop": "npm run build:renderer && node scripts/verify_desktop.cjs",
    "test:renderer": "node scripts/test_renderer.cjs",
    "test:syntax": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer/app.js && node --check renderer/charts.js",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "build:icons": "node scripts/build_icons.cjs",
    "build:excel-addin": "powershell.exe -NoLogo -NoProfile -NonInteractive -File addin/windows/Build.ps1",
    "test:excel-ribbon": "python scripts/generate_excel_ribbon.py --check",
    "build:windows-bridge": "python scripts/build_windows_bridge.py"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.statworkbench.desktop",
    "productName": "StatWorkbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer-dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "assets/statworkbench.png"
    ],
    "extraResources": [
      {
        "from": "dist-backend/statworkbench-engine",
        "to": "engine"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "StatWorkbench reads the worksheets you select in Excel or Numbers and adds analysis results as new worksheets or workbooks."
      },
      "icon": "assets/statworkbench.icns"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/statworkbench.ico",
      "extraResources": [
        {
          "from": "dist-windows/StatWorkbench.SpreadsheetBridge.exe",
          "to": "spreadsheet-bridge/StatWorkbench.SpreadsheetBridge.exe"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education;Science",
      "icon": "assets/statworkbench.png"
    },
    "beforePack": "scripts/verify-package-inputs.cjs"
  },
  "dependencies": {
    "@univerjs/engine-formula": "1.0.4",
    "@univerjs/preset-sheets-core": "1.0.4",
    "@univerjs/preset-sheets-drawing": "1.0.4",
    "@univerjs/preset-sheets-sort": "1.0.4",
    "@univerjs/presets": "1.0.4"
  },
  "type": "module"
}
